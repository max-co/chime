<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.8.xsd">
  <changeSet id="create_artist_1" author="max_co">
    <createTable tableName="artist">
      <column name="id" type="int" autoIncrement="true">
        <constraints primaryKey="true" />
      </column>
      <column name="name" type="varchar(255)">
        <constraints unique="true" nullable="false" />
      </column>
    </createTable>
  </changeSet>

  <changeSet id="create_song_1" author="max_co">
    <createTable tableName="song">
      <column name="id" type="int" autoIncrement="true">
        <constraints primaryKey="true" />
      </column>
      <column name="title" type="varchar(255)">
        <constraints unique="true" nullable="false" />
      </column>
      <column name="language" type="varchar(255)">
        <constraints nullable="false" />
      </column>
      <column name="text" type="text">
        <constraints nullable="false" />
      </column>
      <column name="translation" type="text"> </column>
      <column name="artist_id" type="int">
        <constraints foreignKeyName="fk_song_artist" references="artist(id)" />
      </column>
    </createTable>
  </changeSet>

  <changeSet id="insert_artists_1" author="max_co">
    <sqlFile path="db/changelog/v1/sql/artists.sql" />
    <rollback> DELETE FROM artist WHERE id IN (1, 2) </rollback>
  </changeSet>

  <changeSet id="insert_songs_1" author="max_co">
    <sqlFile path="db/changelog/v1/sql/songs.sql" />
    <rollback> DELETE FROM song WHERE title IN ('short lorem ipsum', 'lorem ipsum') </rollback>
  </changeSet>
</databaseChangeLog>
